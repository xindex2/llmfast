[Unit]
Description=LLMFast inference gateway
Documentation=https://github.com/llmfast/gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=llmfast
Group=llmfast
ExecStart=/opt/llmfast/llmfast -config /etc/llmfast/config.yaml
EnvironmentFile=/etc/llmfast/env

# SIGHUP reloads models and pricing in place; systemctl reload sends it.
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
# Long enough for in-flight generations to drain rather than being cut off
# mid-stream, which would count against uptime at OpenRouter.
TimeoutStopSec=45

Restart=always
RestartSec=2

# Streaming holds one connection per in-flight request in each direction, plus
# the pooled upstream connections. The default 1024 is far too low.
LimitNOFILE=65535

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/llmfast
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
