[Unit]
# A config that will not parse fails identically every time. Without a limit
# systemd retries it hundreds of times and buries the one useful line in the
# journal; with one it stops and leaves the service visibly failed.
#
# These live in [Unit], not [Service]: systemd before 249 ignores them there
# and warns, which is noise in the journal and no limit in practice.
StartLimitIntervalSec=60
StartLimitBurst=5
Description=LLMFast inference gateway
Documentation=https://github.com/llmfast/gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=__USER__
Group=__USER__
ExecStart=__PREFIX__/llmfast -config __CONFDIR__/config.yaml
EnvironmentFile=__CONFDIR__/env

# SIGHUP reloads models and pricing in place; systemctl reload sends it.
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
# Long enough for in-flight generations to drain rather than being cut off
# mid-stream, which would count against uptime at OpenRouter.
TimeoutStopSec=45

Restart=always
RestartSec=2

# Streaming holds one connection per in-flight request in each direction, plus
# the pooled upstream connections. The default 1024 is far too low.
LimitNOFILE=65535

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__STATEDIR__
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
