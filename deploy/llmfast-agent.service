[Unit]
Description=LLMFast inference node agent
Documentation=https://github.com/llmfast/gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=llmfast
Group=llmfast
ExecStart=/opt/llmfast/llmfast-agent \
  -listen 10.0.0.11:9900 \
  -name gpu-a \
  -state-dir /var/lib/llmfast-agent \
  -mode docker
EnvironmentFile=/etc/llmfast/agent.env

KillSignal=SIGTERM
# Long enough for engines to shut down cleanly and release GPU memory. A
# SIGKILL here can leave workers orphaned still holding VRAM.
TimeoutStopSec=90

Restart=always
RestartSec=5

# Weight downloads and many concurrent engine connections.
LimitNOFILE=65535

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/llmfast-agent
# Deliberately NOT sandboxed as tightly as the gateway: this process launches
# inference engines, which need GPU devices, large shared memory and, in docker
# mode, the container socket.

[Install]
WantedBy=multi-user.target
